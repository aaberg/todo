# Public URL of this relay (no trailing slash)
TODO_RELAY_PUBLIC_URL=https://relay.aaberg.cc

# Address to bind on (behind Caddy, so localhost is fine)
TODO_RELAY_BIND=127.0.0.1:3000

# SQLite database path
TODO_RELAY_DATABASE=/var/lib/todo-relay/relay.db

# OIDC provider (your Authelia instance)
TODO_OIDC_ISSUER=https://auth.aaberg.cc
TODO_OIDC_CLIENT_ID=todo-relay
TODO_OIDC_CLIENT_SECRET=change-me

# Comma-separated list of Authelia groups allowed to sync
TODO_ALLOWED_GROUPS=todo-users

# Session lifetime in seconds (default: 30 days)
TODO_SESSION_TTL_SECS=2592000

# Logging
RUST_LOG=todo_relay=info,tower_http=info
